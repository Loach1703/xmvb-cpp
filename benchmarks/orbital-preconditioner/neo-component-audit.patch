+      const Eigen::VectorXd eliminated =
+          coupling.orbital_hessian +
+          orbital_hessian.apply_structure_coupling_adjoint(
+              response.coefficient_responses.at(0),
+              response.adjoint_multipliers.at(0));
+      const Eigen::MatrixXd coefficients =
+          objective->second_order_context()->selected_state_eigenvectors;
+      const auto print = [](const char* key, double value) {
+        std::fprintf(stderr, "NEO_COMPONENT,%s,%.17g\n", key, value);
