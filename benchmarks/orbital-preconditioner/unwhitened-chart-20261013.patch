diff --git a/src/vbscf/orbitals/charts/raw.hpp b/src/vbscf/orbitals/charts/raw.hpp
new file mode 100644
index 00000000..dfa360e9
--- /dev/null
+++ b/src/vbscf/orbitals/charts/raw.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <Eigen/Core>
+
+namespace xmvb::vb {
+
+/** @brief A quotient representative without a coordinate inverse square root. */
+struct RawTangent {
+  Eigen::MatrixXd basis;
+  Eigen::MatrixXd inverse_gram;
+  Eigen::MatrixXd metric;
+  Eigen::MatrixXd inverse_metric;
+  Eigen::VectorXd projection, inverse_projection;
+  double radial_gap = 1.0;
+};
+
+/** @brief Shared AO metric of a Euclidean-orthonormal quotient complement.
+ * Normalization is a rank-one downdate. The inverse measures covectors and
+ * shifts local preconditioners; it does not whiten the orbital tangent basis.
+ */
+class RawTangentMetric {
+ public:
+  RawTangentMetric(const Eigen::Ref<const Eigen::MatrixXd>& quotient,
+                   const Eigen::Ref<const Eigen::MatrixXd>& overlap);
+  RawTangent apply(const Eigen::Ref<const Eigen::MatrixXd>& quotient,
+                   const Eigen::Ref<const Eigen::VectorXd>& coefficients,
+                   const Eigen::Ref<const Eigen::MatrixXd>& overlap,
+                   bool sphere) const;
+  const Eigen::MatrixXd& metric() const noexcept { return metric_; }
+  const Eigen::MatrixXd& inverse() const noexcept { return inverse_; }
+ private:
+  Eigen::MatrixXd metric_, inverse_;
+};
+
+}  // namespace xmvb::vb
diff --git a/src/vbscf/orbitals/charts/raw.cpp b/src/vbscf/orbitals/charts/raw.cpp
new file mode 100644
index 00000000..c4d8085d
--- /dev/null
+++ b/src/vbscf/orbitals/charts/raw.cpp
@@ -0,0 +1,95 @@
+#include "vbscf/orbitals/charts/raw.hpp"
+
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <Eigen/Cholesky>
+#include <Eigen/LU>
+#include <lapacke.h>
+
+#include "vbscf/diagnostics/performance/phases.hpp"
+
+namespace xmvb::vb {
+
+RawTangentMetric::RawTangentMetric(
+    const Eigen::Ref<const Eigen::MatrixXd>& quotient,
+    const Eigen::Ref<const Eigen::MatrixXd>& overlap) {
+  diagnostics::ScopedPhase phase(diagnostics::Phase::ChartGram);
+  metric_.noalias() = quotient.transpose() * overlap * quotient;
+  metric_ = (0.5 * (metric_ + metric_.transpose())).eval();
+  if (!quotient.cols()) { inverse_ = metric_; return; }
+  const Eigen::LLT<Eigen::MatrixXd> factor(metric_);
+  if (factor.info() != Eigen::Success)
+    throw std::runtime_error("raw quotient AO metric is not positive definite");
+  inverse_ = factor.solve(Eigen::MatrixXd::Identity(metric_.rows(), metric_.cols()));
+}
+
+RawTangent RawTangentMetric::apply(
+    const Eigen::Ref<const Eigen::MatrixXd>& quotient,
+    const Eigen::Ref<const Eigen::VectorXd>& coefficients,
+    const Eigen::Ref<const Eigen::MatrixXd>& overlap,
+    bool sphere) const {
+  diagnostics::ScopedPhase phase(diagnostics::Phase::ChartGram);
+  if (!quotient.cols()) return {quotient, metric_, metric_, inverse_};
+  const Eigen::VectorXd sb = overlap * coefficients;
+  const double squared_norm = coefficients.dot(sb);
+  if (!(squared_norm > 0.0) || !std::isfinite(squared_norm))
+    throw std::runtime_error("raw quotient has nonpositive orbital norm");
+  const double norm = std::sqrt(squared_norm);
+  const Eigen::VectorXd c = coefficients / norm;
+  const Eigen::VectorXd r = quotient.transpose() * (sb / norm);
+  const Eigen::VectorXd image = inverse_ * r;
+  long double squared = 0.0L;
+  for (Eigen::Index i = 0; i < r.size(); ++i)
+    squared += static_cast<long double>(r[i]) * image[i];
+  const double delta = static_cast<double>(1.0L - squared);
+  if (!(delta > 0.0) || !std::isfinite(delta))
+    throw std::runtime_error("raw normalized-orbital metric is rank deficient");
+  RawTangent result;
+  // The factor norm preserves scale invariance without metric whitening.
+  result.basis = quotient;
+  if (sphere) result.basis.noalias() -= c * r.transpose();
+  result.basis *= norm;
+  result.metric = metric_ - r * r.transpose();
+  result.inverse_metric = inverse_ + (image * image.transpose()) / delta;
+  result.projection = r;
+  result.inverse_projection = image;
+  result.radial_gap = delta;
+
+  // Same spectral rank cutoff as explicit whitening. Norm bounds suffice
+  // normally; an inconclusive bound needs eigenvalues only, not a new basis.
+  const double rank_factor = 64.0 * std::numeric_limits<double>::epsilon() * r.size();
+  const double upper = result.metric.cwiseAbs().rowwise().sum().maxCoeff();
+  const double lower = 1.0 /
+      result.inverse_metric.cwiseAbs().rowwise().sum().maxCoeff();
+  if (!(lower > rank_factor * upper)) {
+    Eigen::MatrixXd work = result.metric;
+    Eigen::VectorXd spectrum(r.size());
+    const lapack_int n = static_cast<lapack_int>(r.size());
+    const lapack_int info = LAPACKE_dsyevd(LAPACK_COL_MAJOR, 'N', 'L', n,
+        work.data(), n, spectrum.data());
+    if (info != 0 || !(spectrum[0] > rank_factor * spectrum[n - 1]))
+      throw std::runtime_error("raw normalized-orbital metric is rank deficient");
+  }
+  result.inverse_gram = Eigen::MatrixXd::Identity(r.size(), r.size());
+  if (sphere) {
+    Eigen::MatrixXd z(r.size(), 2);
+    z.col(0).noalias() = quotient.transpose() * c;
+    z.col(1) = r;
+    Eigen::Matrix2d small = z.transpose() * z;
+    small(0, 0) -= c.squaredNorm();
+    small(0, 1) -= 1.0;
+    small(1, 0) -= 1.0;
+    const Eigen::FullPivLU<Eigen::Matrix2d> factor(small);
+    if (!factor.isInvertible())
+      throw std::runtime_error("raw sphere representative is rank deficient");
+    result.inverse_gram.noalias() -= z * factor.solve(z.transpose());
+  }
+  result.inverse_gram /= squared_norm;
+  if (!result.basis.allFinite() || !result.inverse_metric.allFinite() ||
+      !result.inverse_gram.allFinite())
+    throw std::runtime_error("non-finite raw tangent metric");
+  return result;
+}
+
+}  // namespace xmvb::vb
